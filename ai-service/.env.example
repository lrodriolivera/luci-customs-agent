# LUCI AI Service Configuration

# Anthropic API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Server
HOST=0.0.0.0
PORT=8003
DEBUG=true

# Logging
LOG_LEVEL=INFO

# Models
DEFAULT_CHAT_MODEL=claude-sonnet-4-20250514
DEFAULT_COMPLEX_MODEL=claude-opus-4-20250514

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60

# Knowledge Base
KNOWLEDGE_BASE_PATH=./knowledge_base

# OCR (Tesseract)
TESSERACT_CMD=/usr/bin/tesseract
