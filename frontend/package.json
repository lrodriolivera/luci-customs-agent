{
  "name": "luci-customs-agent-frontend",
  "version": "1.0.0",
  "description": "LUCI - Agente Aduanero Inteligente Frontend",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.1.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/lab": "^7.0.1-beta.21",
    "@mui/material": "^7.3.7",
    "@sentry/react": "^10.38.0",
    "amazon-cognito-identity-js": "^6.3.16",
    "axios": "^1.6.3",
    "bullmq": "^5.75.2",
    "date-fns": "^3.0.6",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^1.28.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^16.5.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.3",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.16",
    "cypress": "^15.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.32",
    "rollup-plugin-visualizer": "^6.0.11",
    "vite": "^5.0.10",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "vite build",
    "preview": "vite preview",
    "analyze:bundle": "ANALYZE=true vite build",
    "test:e2e:cypress": "cypress run --spec 'cypress/e2e/smoke-*.cy.js' --config 'specPattern=cypress/e2e/smoke-*.cy.js,video=false' --browser electron --headless",
    "test:e2e:playwright": "playwright test --project=chromium-headless-shell",
    "test:regression": "cypress run --spec 'cypress/e2e/regression-*.cy.js' --config 'specPattern=cypress/e2e/regression-*.cy.js,video=false' --browser electron --headless"
  }
}
