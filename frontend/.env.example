# frontend — plantilla de variables de entorno para los tests E2E
# Copia a frontend/.env (gitignored) y rellena con los valores de 1Password.
# NO commitees valores reales. Los E2E no corren en CI.
#
# Estas variables NO empiezan por VITE_, así que Vite no las incluye en el bundle.

# Usuario y contraseña del usuario de pruebas (cypress/e2e y playwright)
E2E_USER=
E2E_PASS=

# Frase de paso del .p12 de pruebas (solo playwright/aeat-certificates-e2e.spec.js)
E2E_CERT_PASSWORD=

# Entorno objetivo. Por defecto http://localhost:5173 (servidor local de Vite).
# Producción solo si se pasa explícitamente, y con un usuario de pruebas de
# mínimos privilegios, nunca un superadmin:
# BASE_URL=https://aduanas.strixai.ai
