<?xml version="1.0" encoding="UTF-8"?><schema xmlns="http://www.w3.org/2001/XMLSchema" 	xmlns:ListaDecV4Sal="https://www2.agenciatributaria.gob.es/static_files/common/internet/dep/aduanas/es/aeat/adht/band/ws/li/ListaDecV4Sal.xsd" 	targetNamespace="https://www2.agenciatributaria.gob.es/static_files/common/internet/dep/aduanas/es/aeat/adht/band/ws/li/ListaDecV4Sal.xsd" 	elementFormDefault="qualified">
	<annotation>		<documentation>    		Esquema del mensaje de respuesta al solicitar a la Bandeja de Entrada la     		LISTA DE LAS RESPUESTAS pendientes de leer.    		Este mensaje proporciona información de cada una de las declaraciones pendientes     		de leer en la Bandeja de Entrada.    	</documentation>	</annotation>
	<element name="ListaDecV4Sal" type="ListaDecV4Sal:ListaDecV4Sal"/>
	<complexType name="ListaDecV4Sal">		<sequence>			<element name="declaracion" type="ListaDecV4Sal:declaracionType" minOccurs="0" maxOccurs="unbounded"/>		</sequence>	</complexType>
	<complexType name="declaracionType">		<annotation>			<documentation>    		Información necesaria para recuperar una declaración pendiente de leer de la Bandeja de Entrada.    		clave: Clave que identifica univocamente cada respuesta.    		referencia: Referencia del mensaje. Coincide con el valor del campo ID del mensaje de petición.    		tipoRespuesta: Tipo de respuesta. Está en función del tipo de Servicio Web utilizado.	    	</documentation>		</annotation>
		<sequence>			<element name="clave" type="string" minOccurs="1" maxOccurs="1"/>			<element name="referencia" type="string" minOccurs="1" maxOccurs="1"/>			<element name="tipoRespuesta" type="string" minOccurs="1" maxOccurs="1"/>		</sequence>	</complexType>
</schema>