<?xml version="1.0" encoding="UTF-8"?><xs:schema 	xmlns:xs="http://www.w3.org/2001/XMLSchema" 	xmlns="https://www3.agenciatributaria.gob.es/static_files/common/internet/dep/aduanas/es/aeat/adip/jdit/ws/h7/TiposDatosH7.xsd" 	targetNamespace="https://www3.agenciatributaria.gob.es/static_files/common/internet/dep/aduanas/es/aeat/adip/jdit/ws/h7/TiposDatosH7.xsd" 	attributeFormDefault="unqualified" >	<!--====================================================================-->	<!--=====  Tipos de Datos de Identificación de los mensajes H7 =========-->	<!--====================================================================-->		<!--=====  Entrada =========-->	<xs:complexType name="messageEntTd">		  <xs:sequence>				<xs:element name="messageIdentification" 	type="messageIdentificationTd"/>        <xs:element name="messageRecipient" 		type="messageRecipientTd" 	minOccurs="0"/>      				<xs:element name="preparationDate" 			type="DateTd" 				minOccurs="0"/>		<xs:element name="preparationTime" 			type="TimeTd" 				minOccurs="0"/>			<xs:element name="testIndicator" 			type="testIndicatorTd" 		minOccurs="0"/>	  </xs:sequence>			     </xs:complexType>     	<!--=====  Salida =========-->	<xs:complexType name="messageSalTd">	       <xs:annotation>			<xs:documentation>				"correlationIdentifier" corresponde a "messageIdentification" del mensaje al que se da respuesta.			</xs:documentation>	       </xs:annotation>	  <xs:sequence>		<xs:element name="messageIdentification" 	type="messageIdentificationTd"/>        <xs:element name="messageRecipient" 		type="messageRecipientTd"       minOccurs="0"/>        <xs:element name="correlationIdentifier" 	type="messageIdentificationTd" 	minOccurs="0"/>		<xs:element name="preparationDate" 			type="DateTd" 					minOccurs="0"/>		<xs:element name="preparationTime" 			type="TimeTd" 					minOccurs="0"/>		<xs:element name="testIndicator" 			type="testIndicatorTd" 			minOccurs="0"/>	  </xs:sequence>     </xs:complexType>              <xs:complexType name="messageSalCeyMeTd">	       <xs:annotation>			<xs:documentation>				"correlationIdentifier" corresponde a "messageIdentification" del mensaje al que se da respuesta.			</xs:documentation>	       </xs:annotation>	  <xs:sequence>		<xs:element name="messageIdentification" 	type="messageIdentificationTd"/>        <xs:element name="messageRecipient" 		type="messageRecipientTd"       minOccurs="0"/>        <xs:element name="correlationIdentifier" 	type="messageIdentificationTd" 	minOccurs="0"/>		<xs:element name="preparationDate" 			type="DateTd" 					minOccurs="0"/>		<xs:element name="preparationTime" 			type="TimeTd" 					minOccurs="0"/>			  </xs:sequence>     </xs:complexType>    <xs:simpleType name="messageIdentificationTd">      <xs:annotation>			<xs:documentation>            	Identificador de transacción.				Debe ser único.				Se sugiere utilizar TimeStamp del tipo AAAAMMDDHHMMSSNNNNNN, aunque puede ser cualquiera				mientras que la Administración origen garantice la unicidad.							</xs:documentation>	</xs:annotation>    <xs:restriction base="xs:string">      <xs:minLength value="5"/>      <xs:maxLength value="40" />    </xs:restriction>  </xs:simpleType>    <xs:simpleType name="messageRecipientTd">      <xs:annotation>			<xs:documentation>			-Mensaje de Entrada.Admite: 		      'ES.AEAT'= Envío real (igual significado que si se omite este elemento)		      'ES.AEAT.PRUEBAS'= En pruebas		    -Mensaje de Salida.		       NIF del remitente al que se da respuesta		    			</xs:documentation>	</xs:annotation>    <xs:restriction base="xs:string">      <xs:maxLength value="17" />    </xs:restriction>  </xs:simpleType>			  <xs:simpleType name="DateTd">		<xs:annotation>			<xs:documentation>				Fecha con formato AAAAMMDD.   			</xs:documentation>		</xs:annotation>		<xs:restriction base="xs:string">			<xs:length value="8"/>		</xs:restriction>  </xs:simpleType>    <xs:simpleType name="TimeTd">		<xs:annotation>			<xs:documentation>				Hora con precisión de segundos HHMMSS.			</xs:documentation>		</xs:annotation>		<xs:restriction base="xs:string">			<xs:length value="6"/>		</xs:restriction>  </xs:simpleType>    <xs:simpleType name="testIndicatorTd">               <xs:annotation>		  <xs:documentation>Indicador de Test. No es obligatorio.Admite: 		    'S'= Modo pruebas.		    'N'= Envío real. (igual significado que si se omite este elemento)		  </xs:documentation>		</xs:annotation>				<xs:restriction base="alfa_S_N_Td">        </xs:restriction>    </xs:simpleType>      <xs:simpleType name="PeriodTd">		<xs:annotation>			<xs:documentation>				Fecha con formato AAAAMM.   			</xs:documentation>		</xs:annotation>		<xs:restriction base="xs:string">			<xs:length value="6"/>		</xs:restriction>  </xs:simpleType>    		<!--========================================================-->	<!--=====      Tipos de Datos Mensajes H7  =================-->	<!--========================================================-->		<xs:complexType name="representativeTd">	   <xs:sequence>		<xs:element name="ContactPerson" 		   	type="contactPersonTd" 	minOccurs="0"/>		<xs:element name="identificationNumber" 	type="alfaNumMax17Td"   minOccurs="0"/>				<xs:element name="status" 					type="entero_1_Td"		minOccurs="0"/>	   </xs:sequence>	</xs:complexType>			    <xs:complexType name="declarantTd">      <xs:sequence>		<xs:element name="ContactPerson" 		   	type="contactPersonTd" 	minOccurs="0"/>		<xs:element name="name" 					type="alfaNumMax70Td" minOccurs="0"/>				<xs:element name="identificationNumber" 	type="alfaNumMax17Td" />		<xs:element name="Address" 		   		    type="addressTd" 		minOccurs="0"/>	   </xs:sequence>	</xs:complexType>		<xs:complexType name="declarant_Re_Td">      <xs:sequence>			<xs:element name="name" 					type="alfaNumMax70Td" />				<xs:element name="identificationNumber" 	type="alfaNumMax17Td" />	   </xs:sequence>	</xs:complexType>    <xs:complexType name="exporterTd">      <xs:sequence>    		<xs:element name="name" 					type="alfaNumMax70Td" />				<xs:element name="identificationNumber" 	type="alfaNumMax17Td"  minOccurs="0"/>		<xs:element name="Address" 		   			type="addressTd" 	/>	   </xs:sequence>	</xs:complexType>    <xs:complexType name="importerTd">      <xs:sequence>   		<xs:element name="eMailAddress" 			type="alfaNumMax256Td" 		minOccurs="0"/>         <xs:element name="phoneNumber" 				type="alfaNumMax35Td" 		minOccurs="0"/> 		<xs:element name="name" 					type="alfaNumMax70Td" />						<xs:element name="identificationNumber" 	type="alfaNumMax17Td" 	minOccurs="0"/>    		<xs:element name="Address" 		   			type="addressTd" />		<xs:element name="naturalPerson" 		   	type="alfa_S_N_Td" />	 </xs:sequence>							</xs:complexType>		    <xs:complexType   name="addressTd">      <xs:sequence>			<xs:element name="city" 			type="alfaNumMax35Td" />        <xs:element name="country" 		 	type="alfa2Td"/>		<xs:element name="streetAndNumber" 	type="alfaNumMax70Td" />		<xs:element name="postcode" 		type="alfaNumMax17Td" />	  </xs:sequence>	    </xs:complexType>        		<xs:complexType name="contactPersonTd">	  <xs:sequence>        <xs:element name="name" 			type="alfaNumMax70Td" 		minOccurs="0"/> 	  		<xs:element name="eMailAddress" 	type="alfaNumMax256Td" />         <xs:element name="phoneNumber" 		type="alfaNumMax35Td" 		minOccurs="0"/>       </xs:sequence>    </xs:complexType>		    <xs:complexType name="supportingDocumentTd">      <xs:sequence>		<xs:element name="suppDoctype" 			type="alfaNum4Td" />		<xs:element name="suppDoctRefNum" 		type="alfaNumMax70Td"/>	  </xs:sequence>			</xs:complexType>				<xs:complexType name="identificationTd">	   <xs:annotation>			<xs:documentation>			    código del NIF, EORI o Número de identificación 			    de la persona Física o Jurídica.			</xs:documentation>	   </xs:annotation>	   <xs:sequence>	     <xs:element name="identificationNumber" 	type="alfaNumMax17Td" />	   </xs:sequence>			</xs:complexType>					    <xs:complexType name="additionalInformationTd">	  <xs:annotation>			<xs:documentation> 				 code. Valores posibles:				-Código de la Unión: n1 + an4				-Código nacional:	 a1 + an4            </xs:documentation>	  </xs:annotation>          <xs:sequence>		<xs:element name="code"       type="alfaNum5Td" />		<xs:element name="additionalInformationDescription"   type="alfaNumMax256Td" />	  </xs:sequence>				</xs:complexType>									    <xs:complexType name="previousDocumentTd">      <xs:sequence>		<xs:element name="prevDocRefNum" 		type="alfaNumMax35Td" />		<xs:element name="prevDocType" 			type="alfaNumMax3Td"/>	  </xs:sequence>	</xs:complexType>	    <xs:complexType name="additionalFiscalRefTd">       <xs:sequence>		<xs:element name="additionalFiscalRefVATId" type="alfaNumMax17Td" />		<xs:element name="additionalFiscalRefRole"  type="alfaNum3Td" />	   </xs:sequence>			</xs:complexType>	    <xs:complexType name="additionalProcedureTd">      <xs:annotation>		<xs:documentation> 		additionalProcedureCode. Valores posibles:				-Código de la Unión: an1 + an2				-Código nacional:	 n1 + an2        </xs:documentation>	  </xs:annotation>      <xs:sequence>		<xs:element name="additionalProcedureCode"  	type="alfaNum3Td" />	  </xs:sequence>						</xs:complexType>						<xs:complexType name="goodsItemTd">	  <xs:sequence>			<xs:element name="declarationGoodsItemNumber"   type="entero_5_Td" />		<xs:element name="Value" 						type="valueTd" 	/>		<xs:element name="Commodity" 					type="commodityTd" />		<xs:element name="GoodsMeasure" 				type="goodsMeasureTd" />		<xs:element name="numberOfPackages" 			type="entero_8_Td" 	minOccurs="0"/>	  </xs:sequence>											</xs:complexType>							<xs:complexType name="additionalReferenceTd">	  <xs:sequence>			<xs:element name="addRefType"   type="alfaNum4Td" />		<xs:element name="addRefNum" 	type="alfaNumMax70Td" />	  </xs:sequence>											</xs:complexType>		<xs:complexType name="transportDocumentTd">	  <xs:sequence>			<xs:element name="transportDocType"   type="alfaNum4Td" />		<xs:element name="transportDocRefNum" 	type="alfaNumMax70Td" />	  </xs:sequence>											</xs:complexType>						<xs:complexType name="goodsItemSalTd">	  <xs:sequence>			<xs:element name="declarationGoodsItemNumber"   type="entero_5_Td" />		<xs:element name="Value" 						type="amountTd" />		<xs:element name="ItemTranspCostToDest" 		type="amountTd" />		<xs:element name="Tax" 		        		    type="tax_1Td" minOccurs="0" maxOccurs="9"/>	  </xs:sequence>											</xs:complexType>			                	<xs:complexType name="valueTd">	   <xs:sequence>		<xs:element name="amount" 		 type="decimal_16_2_Td" />        <xs:element name="currencyCode"  type="alfa3Td" />        </xs:sequence>           </xs:complexType>	<xs:complexType name="amountTd">	   <xs:sequence>		<xs:element name="amount" 		 type="decimal_16_2_Td" />  	   </xs:sequence>      </xs:complexType>                  	<xs:complexType name="commodityTd">      <xs:sequence>		<xs:element name="descriptionOfGoods" type="alfaNumMax512Td" />        <xs:element name="commodityCode" 	  type="alfaNum8Td" 	/>       </xs:sequence>           </xs:complexType>    	<xs:complexType name="goodsMeasureTd">	   <xs:sequence>		<xs:element name="grossMass" 			type="decimal_16_6_Td"  />        <xs:element name="supplementaryUnits"   type="decimal_16_6_Td" minOccurs="0"/>        </xs:sequence>        </xs:complexType>              			    <xs:simpleType name="MRNTd">		<xs:annotation>			<xs:documentation>				Número de referencia del DUA de la declaración aduanera.				Longitud 18, Formato AAESRRRRRRTANNNNND 				('AA'año + ES país España +'RRRRRR' Aduana + 'T' tipo documento 'ANNNNN' Nº referencia )			</xs:documentation>		</xs:annotation>		<xs:restriction base="xs:string">			<xs:length value="18"/>		</xs:restriction>	</xs:simpleType>	    <xs:simpleType name="MRN_Partida_Td">		<xs:annotation>			<xs:documentation>				Número de referencia del DUA+partida de la declaración aduanera.				Longitud 23, Formato AAESRRRRRRTANNNNNDPPPPP 				('AA'año + ES país España +'RRRRRR' Aduana + 'T' tipo documento 'ANNNNN' Nº referencia + 'PPPPP': Nº de partida)			</xs:documentation>		</xs:annotation>		<xs:restriction base="xs:string">			<xs:length value="23"/>		</xs:restriction>	</xs:simpleType>			<xs:complexType name="responseTd">		  <xs:annotation>		    <xs:documentation> 		    responseCode. Admite: 		    'A'= Aceptacion.		    'R'= Rechazo por error funcional o no funcional.		    		    operationCode. Admite: 		    Alta:		    '0'= Admisión H7.		    '1'= Presentación PreH7.		    Anulacion:		    '0'= Anulación H7.		    Reexportacion:		    		    '0'= H7 pasa a estado INvalidado			'2'= H7 pasa a estado LEvante.		    		    		    </xs:documentation>		  </xs:annotation>			  <xs:sequence>		<xs:element name="responseCode" 		   	type="alfaNum1Td" />				 				<xs:element name="operationCode" 			type="alfaNum1Td" 	minOccurs="0"/> 	  </xs:sequence>				</xs:complexType>		<xs:complexType name="errorTd">		  <xs:annotation>		    <xs:documentation>		    ErrorType. Admite: 		    'F'= errores funcionales.		    'N'= errores no funcionales		    </xs:documentation>		   </xs:annotation>		  <xs:sequence>		<xs:element name="errorType" 				type="alfaNum1Td"  	/>				<xs:element name="errorCode" 	  			type="entero_4_Td"  />		<xs:element name="errorReason" 				type="alfaNumMax512Td"  />		<xs:element name="errorPointerGoodsItem" 	type="entero_5_Td"  	minOccurs="0"/> 		<xs:element name="errorPointerDataElement" 	type="entero_3_Td"  	minOccurs="0"/> 		<xs:element name="errorPointerTag"			type="alfaNumMax35Td"  	minOccurs="0"/> 		<xs:element name="originalAttributeValue" 	type="alfaNumMax512Td"  minOccurs="0"/>	  </xs:sequence> 						         </xs:complexType>     	<xs:complexType name="calculationOfTaxesTd">	  <xs:sequence>		<xs:element name="currencyCode" 		type="alfa3Td" />		<xs:element name="Tax" 	  				type="tax_2Td"  minOccurs="0" maxOccurs="9"/>			   </xs:sequence>    </xs:complexType>              	<xs:complexType name="tax_1Td">	  <xs:sequence>		<xs:element name="taxType" 				type="alfaNumMax4Td"/>		<xs:element name="ItemTaxBase" 	  		type="amountTd" minOccurs="0" />		<xs:element name="ItemPayableTaxAmount" type="amountTd"  />		<xs:element name="itemTaxRate" 	  		type="decimal_3_2_Td" minOccurs="0" />						   </xs:sequence>    </xs:complexType>    	<xs:complexType name="tax_2Td">	  <xs:sequence>		<xs:element name="taxType" 				type="alfaNumMax4Td"/>		<xs:element name="payableTaxAmount" 	type="decimal_16_2_Td"  />					<xs:element name="taxBase" 	  		    type="decimal_16_2_Td" minOccurs="0" />				   </xs:sequence>    </xs:complexType> 	<xs:complexType name="MRN_Re_Td">	  <xs:sequence>		<xs:element name="MRN_H7" 		type="MRNTd"/>				   </xs:sequence>    </xs:complexType>      	<!--=========================================================================-->	<!--=====      Tipos de Datos Mensajes H7 específicos Ceuta y Melilla  ======-->	<!--=========================================================================-->	<xs:complexType name="representativeCeyMeTd">	   <xs:sequence>		<xs:element name="eMailAddress" 			type="alfaNumMax256Td"  minOccurs="0"/>       		<xs:element name="identificationNumber" 	type="alfaNumMax17Td"   minOccurs="0"/>				<xs:element name="status" 					type="entero_1_Td"		minOccurs="0"/>	   </xs:sequence>	</xs:complexType>			<xs:complexType name="declarantCeyMeTd">      <xs:sequence>		<xs:element name="eMailAddress" 			type="alfaNumMax256Td" minOccurs="0"/>       		<xs:element name="identificationNumber" 	type="alfaNumMax17Td" />	   </xs:sequence>	</xs:complexType>	   	<xs:complexType name="exporterCeyMeTd">     