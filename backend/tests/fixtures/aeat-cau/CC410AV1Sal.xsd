	<xs:annotation>
		<xs:documentation>
    	Esquema de Salida del Servicio que define el mensaje CCI CC414A       	
    	Es la respuesta (Correcta/Error Funcional/Error XML) a:       	    	 
    	anular una PDI 
    	anular una DPA 
    	</xs:documentation>
	</xs:annotation>
	<xs:element name="CC410AV1Sal" type="CC410AV1Sal"/>
	<xs:complexType name="CC410AV1Sal">
		<xs:sequence>
			<!-- Datos transmisión -->
			<xs:element name="Message" type="td11:MessageTypeD"/>			
			<xs:choice>
			  <!-- Respuesta Correcta --> 
			  <xs:element name="CC410A" type="td3:CC410ATypeD" minOccurs="0"/>
			  <!-- Error Funcional -->
			  <xs:element name="CC456A" type="td4:CC456ATypeD"  minOccurs="0"/>
			  <!-- Error XML -->
			  <xs:element name="CD917A" type="td5:CD917AType"  minOccurs="0"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
