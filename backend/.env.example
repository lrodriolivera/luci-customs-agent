# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/luci-customs

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Claude AI
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_SERVICE_URL=http://localhost:8003

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=LUCI Aduanas <noreply@luci-customs.com>

# Frontend URL (for CORS and links)
FRONTEND_URL=http://localhost:3001

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# TARIC API (European Commission)
TARIC_API_URL=https://ec.europa.eu/taxation_customs/dds2/taric

# Exchange Rates
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
