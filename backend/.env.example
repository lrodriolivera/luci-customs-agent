# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/luci-customs

# JWT
# IMPORTANT: Generate a strong unique secret (min 32 chars).
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_crypto_randomBytes_48_hex
JWT_EXPIRES_IN=7d
JWT_ISSUER=luci-customs-agent
JWT_AUDIENCE=luci-api
# During rollout set to 'true' so tokens signed before iss/aud validation still work.
# After 7d (token expiry window) set back to 'false'.
JWT_LEGACY_MODE=false

# Claude AI
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_SERVICE_URL=http://localhost:8003

# ===========================================
# AWS Bedrock (motor de IA)
# ===========================================
# Sin estas dos claves el servicio arranca en modo demo y devuelve respuestas
# simuladas: no falla, simplemente no llama al modelo.
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=us-east-1

# Modelos (opcional). Bedrock exige inference profiles: el ID desnudo se rechaza
# con "on-demand throughput isn't supported", de ahi el prefijo us.
# Sobreescribir permite mover un modelo de cuenta o revertir sin desplegar.
#   BEDROCK_OPUS_MODEL   -> clasificacion TARIC, generacion H1, analisis legal
#   BEDROCK_SONNET_MODEL -> consultas medias y chat
#   BEDROCK_FAST_MODEL   -> validacion documental y chat simple
# BEDROCK_OPUS_MODEL=us.anthropic.claude-opus-5
# BEDROCK_SONNET_MODEL=us.anthropic.claude-sonnet-5
# BEDROCK_FAST_MODEL=us.anthropic.claude-sonnet-5

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=LUCI Aduanas <noreply@luci-customs.com>

# Frontend URL (for CORS and links)
FRONTEND_URL=http://localhost:3001

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# TARIC API (European Commission)
TARIC_API_URL=https://ec.europa.eu/taxation_customs/dds2/taric

# Exchange Rates
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# ===========================================
# AEAT Integration - Certificado Digital
# ===========================================
AEAT_ENVIRONMENT=simulation                    # simulation | test | production
AEAT_CERTIFICATE_PATH=./Certificados/tu-certificado.p12
AEAT_CERTIFICATE_PASSWORD=tu-password-seguro
AEAT_REPRESENTATIVE_NIF=B12345678              # NIF del representante aduanero
AEAT_FORCE_SIMULATION=true                     # Forzar modo simulacion
AEAT_SIMULATION_DELAY_MS=1500                  # Delay para simular latencia (ms)
AEAT_SIMULATION_ERROR_RATE=0.05                # Probabilidad de error simulado (5%)

# Clave de encriptación para almacenar certificados (CAMBIAR EN PRODUCCIÓN)
CERT_ENCRYPTION_KEY=change-this-encryption-key-in-production

# ===========================================
# Stripe (Payments)
# ===========================================
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# ===========================================
# Super Admins (createSuperAdmin.js)
# ===========================================
# Contrasenas de arranque de los usuarios admin. Las lee el script de seed.
SUPERADMIN_TESTER_PASSWORD=change-me
SUPERADMIN_LUIS_PASSWORD=change-me
SUPERADMIN_JENIFER_PASSWORD=change-me
